+#include "hardware/sd_logger.h"
+
+// Not in hardware/pins.h on purpose: nothing else touches these, and the
+// variant header is the source (variants/wt32-sc01-plus/pins_arduino.h).
+#define SOUND_PIN_LRCK  35
+#define SOUND_PIN_BCLK  36
+#define SOUND_PIN_DOUT  37
+
+#define SOUND_RATE      16000
+#define SOUND_RAMP_MS   4      // fade in and out: no click at either end
+#define SOUND_REPEAT_MS 4000   // the same tag again within this stays quiet
+
+uint8_t g_sound_volume = SOUND_MEDIUM;
+
+// Peak amplitude per volume step, of 32767. The NS4168 has no volume control
+// of its own, so the samples are the volume.
+static const int16_t PEAK[SOUND_VOLUME_COUNT] = {0, 2500, 7000, 16000};
+
+struct Note { uint16_t hz; uint16_t ms; };  // hz 0 = a pause
+
+static const Note TUNE_FOUND[]   = {{1760, 70}};
+static const Note TUNE_UNKNOWN[] = {{440, 90}, {0, 70}, {440, 90}};
+static const Note TUNE_LINKED[]  = {{1319, 80}, {0, 15}, {1760, 130}};
+
+static QueueHandle_t s_queue = nullptr;
+
+static void writeNote(i2s_chan_handle_t tx, const Note& n, int16_t peak) {
+  const uint32_t frames = (uint32_t)SOUND_RATE * n.ms / 1000;
+  const uint32_t ramp = (uint32_t)SOUND_RATE * SOUND_RAMP_MS / 1000;
+  int16_t buf[128 * 2];  // stereo frames: both channels the same, whatever the amp listens to
+  float phase = 0.0f;
+  const float step = 2.0f * (float)M_PI * n.hz / SOUND_RATE;
+  for (uint32_t done = 0; done < frames;) {
+    const uint32_t chunk = min<uint32_t>(128, frames - done);
+    for (uint32_t i = 0; i < chunk; i++) {
+      const uint32_t f = done + i;
+      float env = 1.0f;
+      if (f < ramp) env = (float)f / ramp;
+      else if (frames - 1 - f < ramp) env = (float)(frames - 1 - f) / ramp;  // last frame: 0
+      const int16_t v = n.hz ? (int16_t)(sinf(phase) * peak * env) : 0;
+      phase += step;
+      if (phase > 2.0f * (float)M_PI) phase -= 2.0f * (float)M_PI;
+      buf[2 * i] = v;
+      buf[2 * i + 1] = v;
+    }
+    size_t written = 0;
+    i2s_channel_write(tx, buf, chunk * 2 * sizeof(int16_t), &written, portMAX_DELAY);
+    done += chunk;
+  }
+}
+
+// The ESP-IDF standard-mode driver directly rather than the Arduino I2SClass:
+// that wrapper also links the PDM and TDM modes, and with them ~30 kB more than
+// a speaker needs - enough to push the image past the 3 MB app slot that devices
+// flashed with the older partition table still have.
+static void playTune(const Note* notes, size_t count, int16_t peak) {
+  i2s_chan_handle_t tx = nullptr;
+  i2s_chan_config_t chan = I2S_CHANNEL_DEFAULT_CONFIG(I2S_NUM_AUTO, I2S_ROLE_MASTER);
+  chan.auto_clear = true;  // the DMA plays silence, not the last buffer, once drained
+  if (i2s_new_channel(&chan, &tx, nullptr) != ESP_OK) {
+    logSD("Sound: no I2S channel");
+    return;
+  }
+  i2s_std_config_t std = {
+    .clk_cfg  = I2S_STD_CLK_DEFAULT_CONFIG(SOUND_RATE),
+    .slot_cfg = I2S_STD_PHILIPS_SLOT_DEFAULT_CONFIG(I2S_DATA_BIT_WIDTH_16BIT, I2S_SLOT_MODE_STEREO),
+    .gpio_cfg = {
+      .mclk = I2S_GPIO_UNUSED,
+      .bclk = (gpio_num_t)SOUND_PIN_BCLK,
+      .ws   = (gpio_num_t)SOUND_PIN_LRCK,
+      .dout = (gpio_num_t)SOUND_PIN_DOUT,
+      .din  = I2S_GPIO_UNUSED,
+      .invert_flags = { .mclk_inv = false, .bclk_inv = false, .ws_inv = false },
+    },
+  };
+  if (i2s_channel_init_std_mode(tx, &std) != ESP_OK || i2s_channel_enable(tx) != ESP_OK) {
+    logSD("Sound: I2S would not start");
+    i2s_del_channel(tx);
+    return;
+  }
+  for (size_t i = 0; i < count; i++) writeNote(tx, notes[i], peak);
+  // Silence behind the tune, so the DMA has played the last note out before
+  // the peripheral is released.
+  const Note tail = {0, 40};
+  writeNote(tx, tail, 0);
+  i2s_channel_disable(tx);
+  i2s_del_channel(tx);
+}
+
+static void soundTask(void*) {
+  uint8_t id;
+  for (;;) {
+    if (xQueueReceive(s_queue, &id, portMAX_DELAY) != pdTRUE) continue;
+    const uint8_t vol = g_sound_volume;
+    if (vol == SOUND_OFF || vol >= SOUND_VOLUME_COUNT) continue;
+    switch (id) {
+      case SND_TAG_FOUND:   playTune(TUNE_FOUND, 1, PEAK[vol]); break;
+      case SND_TAG_UNKNOWN: playTune(TUNE_UNKNOWN, 3, PEAK[vol]); break;
+      case SND_TAG_LINKED:  playTune(TUNE_LINKED, 3, PEAK[vol]); break;
+      default: break;
+    }
+  }
+}
+
+void soundPlay(SoundId id) {
+  if (g_sound_volume == SOUND_OFF) return;
+  if (!s_queue) {
+    // First sound: the queue and the task. Core 0, beside the backend and web
+    // jobs; low priority, a beep can wait a moment.
+    s_queue = xQueueCreate(4, sizeof(uint8_t));
+    if (!s_queue) return;
+    if (xTaskCreatePinnedToCore(soundTask, "sound", 3072, nullptr, 1, nullptr, 0) != pdPASS) {
+      logSD("Sound: task would not start");
+      return;
+    }
+  }
+  const uint8_t v = (uint8_t)id;
+  xQueueSend(s_queue, &v, 0);  // full: dropped, never waited for
+}
+
+static char s_last_uid[40] = "";
+static uint32_t s_last_ms = 0;
+static char s_expect_link[40] = "";
+
+void soundExpectLink(const char* uid) {
+  snprintf(s_expect_link, sizeof(s_expect_link), "%s", uid ? uid : "");
+}
+
+void soundTagVerdict(const char* uid, bool found) {
+  const char* u = uid ? uid : "";
+  const uint32_t now = millis();
+  if (u[0] && !strcmp(u, s_last_uid) && now - s_last_ms < SOUND_REPEAT_MS) return;
+  snprintf(s_last_uid, sizeof(s_last_uid), "%s", u);
+  s_last_ms = now;
+  if (!found && u[0] && !strcmp(u, s_expect_link)) return;  // the chime follows
+  soundPlay(found ? SND_TAG_FOUND : SND_TAG_UNKNOWN);
+}
+
+void soundTagLinked() {
+  s_expect_link[0] = 0;
+  soundPlay(SND_TAG_LINKED);
+}
+
+void soundVolumeChanged() {
+  soundPlay(SND_TAG_FOUND);
+}
diff -ruN a/src/services/sound.h b/src/services/sound.h
--- a/src/services/sound.h	1970-01-01 01:00:00
+++ b/src/services/sound.h	2026-10-21 09:29:35
@@ -0,0 +1,56 @@
+#pragma once
+// ============================================================
+//  sound.h - short sounds through the board's speaker
+//  sdfp fork addition
+// ============================================================
+//
+// The WT32-SC01 Plus has an NS4168 I2S amplifier and a two pin speaker
+// connector (SPK): LRCK GPIO 35, BCLK GPIO 36, DOUT GPIO 37, as the Arduino
+// core's own variant for the board names them. An 8 ohm speaker plugs in.
+//
+// What a scan sounds like:
+//   SND_TAG_FOUND    the tag belongs to a known spool        one short high beep
+//   SND_TAG_UNKNOWN  no spool has this tag                   two low beeps
+//   SND_TAG_LINKED   a tag was just linked to a spool        a rising two tone chime
+//
+// soundPlay() only queues: a small task on core 0 drives the I2S peripheral,
+// so neither the loop (NFC, scale, LVGL) nor a web handler ever waits on it.
+// The peripheral is set up per sound and released after, so an idle speaker
+// does not hiss.
+
+#include <stdint.h>
+
+enum SoundId : uint8_t {
+  SND_TAG_FOUND = 0,
+  SND_TAG_UNKNOWN,
+  SND_TAG_LINKED,
+};
+
+// The setting (NVS key "sound_vol", in the settings registry).
+enum SoundVolume : uint8_t {
+  SOUND_OFF = 0,
+  SOUND_LOW,
+  SOUND_MEDIUM,
+  SOUND_HIGH,
+  SOUND_VOLUME_COUNT
+};
+extern uint8_t g_sound_volume;
+
+// Queues a sound. Does nothing with the volume off; drops it when sounds are
+// already queued up. Safe from any task, including LVGL callbacks.
+void soundPlay(SoundId id);
+
+// The verdict of a tag lookup: found or unknown, once per tag - the same tag
+// within a few seconds (one that wobbles in and out of the field, a repeat
+// lookup) stays quiet. An unknown tag that is about to be linked by its spool
+// URL stays quiet too: the chime follows when the link is done.
+void soundTagVerdict(const char* uid, bool found);
+
+// Marks the tag a link was just parked for (services/spool_url.cpp).
+void soundExpectLink(const char* uid);
+
+// A tag was linked to a spool: the chime.
+void soundTagLinked();
+
+// The settings row's on_change: a preview at the new volume.
+void soundVolumeChanged();
